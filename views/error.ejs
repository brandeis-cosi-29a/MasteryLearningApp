<%- include('bootheader') -%>
<% if (!submissionError) { %>
  <%- include('menubar') -%>
<% } %>
<div class="px-5 py-3 bg-light">
  <div class="container-fluid ">
    <h1 class="pb-2 border-bottom">Error - <%= message %></h1>
    <% if (submissionError) { %>
      <p>You may still be signed in. Use your browser's Back button and try again.</p>
    <% } %>
    <h2>
      <%= error.status %>
    </h2>
    <pre class="bg-white border rounded" style="font-size: 12px !important;"><%= error.stack %></pre>
  </div>
</div>
<%- include('bootfooter') -%>
<%- include('htmlfoot') -%>
